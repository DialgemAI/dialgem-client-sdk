{
  "name": "@dialgem/client",
  "version": "1.0.0",
  "description": "Talk to a Dialgem voice agent from a web page: microphone capture, streaming playback and call events, with a small React hook.",
  "keywords": [
    "dialgem",
    "voice-ai",
    "voice-agent",
    "webrtc",
    "web-audio",
    "browser",
    "react"
  ],
  "license": "Apache-2.0",
  "author": "Dialgem",
  "homepage": "https://github.com/DialgemAI/dialgem-client-sdk#readme",
  "bugs": {
    "url": "https://github.com/DialgemAI/dialgem-client-sdk/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DialgemAI/dialgem-client-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.cts"
      ]
    }
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "lint:package": "publint --strict && attw --pack .",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "22.20.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "jsdom": "^30.1.3",
    "publint": "0.3.24",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.10.0"
}
